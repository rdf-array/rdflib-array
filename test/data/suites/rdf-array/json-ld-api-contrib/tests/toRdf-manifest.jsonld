{
  "@context": [
    "https://w3c.github.io/json-ld-api/tests/context.jsonld",
    {
      "@base": "toRdf-manifest",
      "ra": "https://rdf-array.github.io/rdf-array/vocab#",
      "undefSlots": "ra:undefSlots",
      "requires": {
        "@id": "mf:requires",
        "@type": "@id"
      }
    }
  ],
  "@id": "",
  "@type": "mf:Manifest",
  "name": "rdf-array: Transform JSON-LD to RDF (sequences)",
  "description": "JSON-LD to rdf-array: a @list is one sequence term.",
  "baseIri": "https://rdf-array.github.io/json-ld-api-contrib/tests/",
  "sequence": [
    {
      "@id": "#tli01",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li01",
      "purpose": "rdf-array: a @list of strings is one sequence term",
      "input": "toRdf/li01-in.jsonld",
      "expect": "toRdf/li01-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli02",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li02",
      "purpose": "rdf-array: an empty @list is the empty sequence, not rdf:nil",
      "input": "toRdf/li02-in.jsonld",
      "expect": "toRdf/li02-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli03",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li03",
      "purpose": "rdf-array: nested lists are nested sequences",
      "input": "toRdf/li03-in.jsonld",
      "expect": "toRdf/li03-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli04",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li04",
      "purpose": "rdf-array: empty sequences nested",
      "input": "toRdf/li04-in.jsonld",
      "expect": "toRdf/li04-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli05",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li05",
      "purpose": "rdf-array: an array value of a @container @list term is one sequence",
      "input": "toRdf/li05-in.jsonld",
      "expect": "toRdf/li05-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli06",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li06",
      "purpose": "rdf-array: a single non-array @list value is a one-element sequence",
      "input": "toRdf/li06-in.jsonld",
      "expect": "toRdf/li06-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli07",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li07",
      "purpose": "rdf-array: null inside a @list leaves no element",
      "input": "toRdf/li07-in.jsonld",
      "expect": "toRdf/li07-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli08",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li08",
      "purpose": "rdf-array: node objects as elements; a blank node element keeps its own triples",
      "input": "toRdf/li08-in.jsonld",
      "expect": "toRdf/li08-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli09",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li09",
      "purpose": "rdf-array: a sequence in a named graph",
      "input": "toRdf/li09-in.jsonld",
      "expect": "toRdf/li09-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli10",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li10",
      "purpose": "rdf-array: IRI elements resolved against @base",
      "input": "toRdf/li10-in.jsonld",
      "expect": "toRdf/li10-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli11",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li11",
      "purpose": "rdf-array: native values and a language-tagged string as elements",
      "input": "toRdf/li11-in.jsonld",
      "expect": "toRdf/li11-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli12",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li12",
      "purpose": "rdf-array: a @set is still two values, not a sequence",
      "input": "toRdf/li12-in.jsonld",
      "expect": "toRdf/li12-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tli13",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "li13",
      "purpose": "rdf-array: two equal lists are one sequence term",
      "input": "toRdf/li13-in.jsonld",
      "expect": "toRdf/li13-out.nq",
      "option": {
        "specVersion": "json-ld-1.1"
      }
    },
    {
      "@id": "#tundef-li01",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li01",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null in a @list is a slot",
      "input": "toRdf/undef-li01-in.jsonld",
      "expect": "toRdf/undef-li01-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li02",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li02",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a list of nothing but a null has length 1",
      "input": "toRdf/undef-li02-in.jsonld",
      "expect": "toRdf/undef-li02-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li03",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li03",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: two slots",
      "input": "toRdf/undef-li03-in.jsonld",
      "expect": "toRdf/undef-li03-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li04",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li04",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a slot at depth",
      "input": "toRdf/undef-li04-in.jsonld",
      "expect": "toRdf/undef-li04-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li05",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li05",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null in the array of a @container @list term",
      "input": "toRdf/undef-li05-in.jsonld",
      "expect": "toRdf/undef-li05-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li06",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li06",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null in a nested array of a @container @list term",
      "input": "toRdf/undef-li06-in.jsonld",
      "expect": "toRdf/undef-li06-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li07",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li07",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a slot in a named graph",
      "input": "toRdf/undef-li07-in.jsonld",
      "expect": "toRdf/undef-li07-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li08",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li08",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: the @id after the list",
      "input": "toRdf/undef-li08-in.jsonld",
      "expect": "toRdf/undef-li08-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li09",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li09",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null that is not in a list is still dropped",
      "input": "toRdf/undef-li09-in.jsonld",
      "expect": "toRdf/undef-li09-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li10",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li10",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null value is still no value",
      "input": "toRdf/undef-li10-in.jsonld",
      "expect": "toRdf/undef-li10-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li11",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li11",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null value of a @container @list term is no value, not a list holding a null",
      "input": "toRdf/undef-li11-in.jsonld",
      "expect": "toRdf/undef-li11-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    },
    {
      "@id": "#tundef-li12",
      "@type": [
        "jld:PositiveEvaluationTest",
        "jld:ToRDFTest"
      ],
      "name": "undef-li12",
      "requires": "ra:UndefSlots",
      "purpose": "rdf-undef: a null value object is still dropped: only a null member is a slot",
      "input": "toRdf/undef-li12-in.jsonld",
      "expect": "toRdf/undef-li12-out.nq",
      "option": {
        "specVersion": "json-ld-1.1",
        "undefSlots": true
      }
    }
  ]
}
